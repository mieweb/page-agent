{
  "name": "@mieweb/page-controller",
  "version": "1.12.4-mie.2",
  "description": "Browser-only PageController distribution from mieweb/page-agent; no LLM runtime",
  "license": "MIT",
  "type": "module",
  "main": "./dist/page-controller.js",
  "types": "./dist/types/PageController.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/PageController.d.ts",
      "import": "./dist/page-controller.js",
      "default": "./dist/page-controller.js"
    },
    "./style.css": "./dist/page-controller.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CONTROLLER-DISTRIBUTION.md",
    "packages/page-controller/src",
    "scripts/build-controller.mjs",
    "tsconfig.controller.json",
    "controller-env.d.ts",
    "licenses",
    "test/controller.browser.test.mjs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mieweb/page-agent.git"
  },
  "scripts": {
    "regenerate": "node scripts/build-controller.mjs",
    "test:controller": "node --test test/controller.browser.test.mjs"
  },
  "devDependencies": {
    "ai-motion": "0.4.8",
    "esbuild": "0.25.12",
    "playwright-core": "1.56.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": [
    "./dist/page-controller.js",
    "./dist/page-controller.css"
  ]
}
